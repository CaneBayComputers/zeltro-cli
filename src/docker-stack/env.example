# Zeltro Environment Configuration
# This file is copied to .env during installation and contains
# configuration shared across all Zeltro scripts and Docker services

# Network configuration (auto-generated during install)
VPC_SUBNET=

# Shared service container names (can be customized; defaults shown)
MARIADB_CONTAINER_NAME=zeltro-mariadb
REDIS_CONTAINER_NAME=zeltro-redis
MEMCACHED_CONTAINER_NAME=zeltro-memcached
MONGO_CONTAINER_NAME=zeltro-mongo
POSTGRES_CONTAINER_NAME=zeltro-postgres
PHPMYADMIN_CONTAINER_NAME=zeltro-phpmyadmin
MAILHOG_CONTAINER_NAME=zeltro-mailhog

# Debug logging
DEBUG_LOG_PATH=/tmp/zeltro-cli-debug.log

# Public IP lookup (used by whatismyip helper)
WHATISMYIP_DNS_NAME=myip.opendns.com
WHATISMYIP_DNS_SERVER=resolver1.opendns.com

# Projects directory - where your development projects are stored
# Default: ~/zeltro-projects (can be customized)
PROJECTS_DIR=~/zeltro-projects

# Preferred AI agent CLI command (claude, codex, agy, qwen, aider, opencode, hermes;
# gemini is deprecated). Blank = the first one installed.
AI_AGENT=

# Default model for AI agent (for example: gpt-4.1, sonnet)
# Required for aider, which has no default login to infer a provider from.
# Aider model names carry their provider: openai/gpt-4o, anthropic/claude-sonnet-4-5.
AI_MODEL=

# AI API key. Optional for codex/claude (they can use their own login instead),
# required for aider. Aider tags keys by provider; a bare key here is tagged
# from the AI_MODEL prefix, or pass it pre-tagged as `provider=key`.
AI_API_KEY=

# OpenAI-compatible API endpoint (aider only) — set this to point aider at
# Ollama, LM Studio, OpenRouter, vLLM, or any other OpenAI-compatible server.
# Leave blank to use the provider's own hosted API.
AI_API_BASE=

# Default Laravel repository for `zeltro laravel`
LARAVEL_REPOSITORY_URL=https://github.com/laravel/laravel.git
#LARAVEL_REPOSITORY_URL=git@github.com:laravel/laravel.git
