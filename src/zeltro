        ;;
    
    # Enhanced Laravel commands
    "db-refresh")
        validate_project_context || exit 1
        echo-yellow "Refreshing database..."
        docker_exec developer php artisan migrate:fresh
        docker_exec developer php artisan db:seed
        echo-green "Database refreshed!"
        ;;
    "cache-refresh")
        validate_project_context || exit 1
        echo-yellow "Clearing Laravel caches..."
        docker_exec developer php artisan cache:clear
        docker_exec developer php artisan route:clear
        docker_exec developer php artisan config:clear
        docker_exec developer composer -d "$(zeltro_container_workdir)" dump-autoload
        echo-green "Caches cleared!"
        ;;
    
    # Service management
    "mysql")
        shift
        if [ -t 0 ]; then
            docker container exec -it "$MARIADB_CONTAINER_NAME" mariadb -u"root" "$@"
        else
            docker container exec -i "$MARIADB_CONTAINER_NAME" mariadb -u"root" "$@"
        fi
        ;;
    "redis")
        shift
        # Only the argument-less REPL needs a TTY. `redis-cli INFO` is a one-shot
        # command, and -t makes it fail outright whenever stdin is not a terminal
        # — which is every GUI, script and agent caller.
        if [ $# -eq 0 ] && [ -t 0 ]; then
            docker container exec -it "$REDIS_CONTAINER_NAME" redis-cli
        else
            docker container exec -i "$REDIS_CONTAINER_NAME" redis-cli "$@"
        fi
        ;;
    "redis-flush")
        # Never interactive.
        docker container exec -i "$REDIS_CONTAINER_NAME" redis-cli FLUSHALL
        echo-green "Redis flushed!"
        ;;
    "memcache")
        shift
        if [ $# -eq 0 ]; then
            echo-yellow "Available Memcached commands:"
            echo "  stats           - Show server statistics"
            echo "  version         - Show server version"
            echo "  flush_all       - Flush all cached items"
            echo "  get <key>       - Get value for key"
            echo "  set <key> <val> - Set key to value"
            echo
            echo-white "Usage: zeltro memcache <command>"
            echo-white "Example: zeltro memcache stats"
        elif [ "$1" = "set" ]; then
            # Storage commands are two-line: the header declares the payload
            # length, then the payload follows. The single-line form this help
            # text has always advertised could never have worked.
            if [ $# -lt 3 ]; then
                echo-red "Usage: $ZELTRO_CMD set <key> <value>"
                exit 1
            fi
            memcache_key="$2"; shift 2
            memcache_value="$*"
            memcache-send "set $memcache_key 0 0 ${#memcache_value}" "$memcache_value"
        else
            memcache-send "$*"
        fi
        ;;
    "memcache-flush")
        memcache-send "flush_all"
        echo-green "Memcached flushed!"
        ;;
    "memcache-stats")
        memcache-send "stats"
        ;;
    "supervisor")
        validate_project_context || exit 1
        shift
        project_name="$(get_project_name)"
        if [ $# -eq 0 ]; then
            echo-yellow "Available supervisorctl commands:"
            echo "  status          - Show process status"
            echo "  start <name>    - Start a process"
            echo "  stop <name>     - Stop a process"
            echo "  restart <name>  - Restart a process"
            echo "  reload          - Reload configuration"
            echo "  reread          - Reread configuration files"
            echo
            echo-white "Usage: zeltro supervisor <command>"
            echo-white "Example: zeltro supervisor status"
        else
            docker container exec -i "$project_name" supervisorctl "$@"
        fi
        ;;
    "supervisor-status")
        validate_project_context || exit 1
        project_name="$(get_project_name)"
        echo-cyan "Supervisor status in container: $project_name"
        docker container exec -i "$project_name" supervisorctl status
        ;;
    
