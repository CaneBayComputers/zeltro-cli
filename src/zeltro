    "projects-dir")
        # Helper command to show projects directory path. Handled inline, so it
        # has to honour --json-output itself or the "global" flag isn't global.
        # The flag is stripped from "$@" at the top of this file and exported as
        # JSON_OUTPUT, so test the variable rather than the arguments.
        if [[ "$JSON_OUTPUT" == "1" ]]; then
            echo "{\"action\": \"projects_dir\", \"projects_dir\": \"$(get_projects_dir)\", \"status\": \"success\"}"
        else
            echo "$(get_projects_dir)"
        fi
        ;;
    
    # Help and default
    "version"|"--version"|"-v")
        _v="$(zeltro_version)"
        zeltro_update_refresh_async
        if [[ "$JSON_OUTPUT" == "1" ]]; then
            echo "{\"action\": \"version\", \"status\": \"success\", \"version\": \"$_v\"}"
        else
            echo "zeltro $_v"
            # `set -e`: a bare `x=$(...) && echo` chain returns 1 when no update
            # is available and takes the whole script down. Guard with `if`.
            if _newer="$(zeltro_update_available)"; then
                echo-yellow "  update available: $_newer — run 'zeltro update'"
            fi
        fi
        ;;
    "help"|"-h"|"--help"|"")
        show_help
        ;;
    *)
        echo-red "Unknown command: $1"
        echo
        show_help
        exit 1
        ;;
esac
