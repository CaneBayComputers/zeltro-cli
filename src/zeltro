#!/bin/bash
# Zeltro - Universal PHP Development Environment
# One command to rule them all

set -e

# Get the directory where this script is actually located (resolve symlinks)
SCRIPT_PATH="${BASH_SOURCE[0]}"
# Resolve symlink if this script is symlinked
while [ -L "$SCRIPT_PATH" ]; do
    SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd)"
    SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
    [[ $SCRIPT_PATH != /* ]] && SCRIPT_PATH="$SCRIPT_DIR/$SCRIPT_PATH"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd)"

# Program name for help text. Scripts print "${ZELTRO_CMD:-$0}" so copy-pasted
# usage is runnable — bare $0 is the sourced script's absolute path, which is
# not a command anyone can type.
#
# This lived INSIDE the symlink loop above until 2026-08-03, so it was only ever
# set when zeltro was invoked through a symlink. A direct invocation left it
# empty and every usage() silently fell back to $0 -- the very bug the export was
# added to fix. The `:-$0` fallback is what hid it.
export ZELTRO_CMD="zeltro${1:+ $1}"

# `zeltro gui event` runs as an agent hook after every turn. It must be quick,
# print nothing and never fail, so it skips functions.sh, the update check and
# the projects-dir setup below and goes straight to the script, which always
# exits 0.
if [ "$1" = "gui" ] && [ "$2" = "event" ]; then
    python3 "$SCRIPT_DIR/scripts/gui.py" "${@:2}" </dev/null >/dev/null 2>&1 || true
    exit 0
fi

# Source functions
source "$SCRIPT_DIR/scripts/functions.sh"

# Note: --no-coloring option removed - use --json-output for clean output instead

# Check for --json-output flag and set JSON_OUTPUT environment variable
new_args=()
for arg in "$@"; do
    if [[ "$arg" == "--json-output" ]]; then
        export JSON_OUTPUT=1
    else
        new_args+=("$arg")
    fi
done
set -- "${new_args[@]}"

# Update check. Must come after functions.sh is sourced and after JSON_OUTPUT is
# parsed -- it was briefly placed above both, where the functions did not exist
# yet and `|| true` turned that into a silent no-op.
zeltro_update_refresh_async 2>/dev/null || true
zeltro_update_notice 2>/dev/null || true

# Initialize projects directory
init_projects_dir

