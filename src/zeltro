# Get current project name (directory basename)
get_project_name() {
    basename "$(pwd)"
}

# Validate that we're in a Zeltro project directory and it's running
validate_project_context() {
    # Check if docker-compose.yaml exists
    if [ ! -f "docker-compose.yaml" ]; then
        echo-red "❌ Not in a Zeltro project directory!"
        echo-white "Current directory: $(pwd)"
        echo-white "Expected: docker-compose.yaml file"
        echo-return
        echo-cyan "💡 Solutions:"
        echo "  • Navigate to a project directory: cd \$(zeltro projects-dir)/your-project"
        echo "  • Create a new project: zeltro new"
        echo "  • List existing projects: ls \$(zeltro projects-dir)"
        return 1
    fi
    
    # Check if it's actually a Zeltro project by looking for the Zeltro VPC network
    if ! zeltro_compose_on_vpc docker-compose.yaml; then
        echo-red "❌ Not a Zeltro project!"
        echo-white "Found docker-compose.yaml but it's not a Zeltro project."
        echo-white "Current directory: $(pwd)"
        echo-return
        echo-cyan "💡 Solutions:"
        echo "  • Navigate to a Zeltro project directory"
        echo "  • Convert this to a Zeltro project: zeltro setup $(basename \"$(pwd)\")"
        return 1
    fi
    
    # Get container name from docker-compose.yaml
    local container_name=$(grep "container_name:" docker-compose.yaml | head -1 | sed 's/.*container_name: *\(.*\)/\1/')
    
    if [ -z "$container_name" ]; then
        echo-red "❌ Invalid docker-compose.yaml!"
        echo-white "Could not find container_name in docker-compose.yaml"
        return 1
    fi
    
    # Check if container is running
    if ! docker ps --format "{{.Names}}" | grep -q "^${container_name}$"; then
        echo-red "❌ Project not running!"
        echo-white "Project: $(basename \"$(pwd)\")"
        echo-white "Container: $container_name"
        echo-white "Status: Stopped"
        echo-return
        echo-cyan "💡 Solutions:"
        echo "  • Start the project: zeltro up"
        echo "  • Check project status: zeltro status"
        echo "  • View all projects: zeltro status"
        return 1
    fi
    
    # All checks passed
    return 0
}

# Docker exec helper
docker_exec() {
    local user="$1"
    shift
    local project_name="$(get_project_name)"
    # Wrap single quoted compound commands through bash so agents can pass
    # "python3 manage.py foo" as one string without OCI exec errors
    if [ $# -eq 1 ] && [[ "$1" == *" "* ]]; then
        set -- bash -c "$1"
    fi
    local tty_flags="-it"
    [ -t 0 ] || tty_flags="-i"
    if [ "$user" = "root" ]; then
        docker container exec $tty_flags --user root -w "$(zeltro_container_workdir "$project_name")" "$project_name" "$@"
    else
        docker container exec $tty_flags --user "$(id -u):$(id -g)" -w "$(zeltro_container_workdir "$project_name")" "$project_name" "$@"
    fi
}

# Docker exec helper without TTY (for automation/CI)
docker_exec_notty() {
    local user="$1"
    shift
    local project_name="$(get_project_name)"
    # Wrap single quoted compound commands through bash so agents can pass
    # "python3 manage.py foo" as one string without OCI exec errors
    if [ $# -eq 1 ] && [[ "$1" == *" "* ]]; then
        set -- bash -c "$1"
    fi
    if [ "$user" = "root" ]; then
        docker container exec -i --user root -w "$(zeltro_container_workdir "$project_name")" "$project_name" "$@"
    else
        docker container exec -i --user "$(id -u):$(id -g)" -w "$(zeltro_container_workdir "$project_name")" "$project_name" "$@"
    fi
}

# Detect project framework from files present in the current directory
detect_project_framework() {
    if [ -f "artisan" ]; then
        echo "laravel"
    elif [ -f "manage.py" ]; then
        echo "django"
    elif [ -f "package.json" ]; then
        if grep -q '"@nestjs/core"' package.json 2>/dev/null; then
            echo "nestjs"
        else
            echo "node"
        fi
    elif [ -f "requirements.txt" ] || [ -f "main.py" ] || [ -f "app.py" ]; then
        echo "python"
    elif [ -f "composer.json" ]; then
        echo "php"
    else
        echo "unknown"
    fi
}

# Main command dispatcher
case "$1" in
    # Containerized development tools
    "composer")
        validate_project_context || exit 1
        shift
        docker_exec developer composer -d "$(zeltro_container_workdir)" "$@"
        ;;
    "art"|"artisan")
        validate_project_context || exit 1
        shift
        docker_exec developer php artisan "$@"
        ;;
    "drush")
        # Drupal's artisan. drush is a Composer dependency, not a global binary,
        # so it runs from vendor/bin relative to the container workdir — and it is
        # invoked directly, NOT as `php vendor/bin/drush`: Composer 2 installs it
        # as a `#!/usr/bin/env sh` proxy, so a php prefix just prints the wrapper.
        validate_project_context || exit 1
        shift
        docker_exec developer vendor/bin/drush "$@"
        ;;
    "wp")
        validate_project_context || exit 1
        shift
        docker_exec developer wp "$@"
        ;;
    "php")
        validate_project_context || exit 1
        shift
        docker_exec developer php "$@"
        ;;
    "npm")
        validate_project_context || exit 1
        shift
        docker_exec_notty developer npm "$@"
        ;;
    "npx")
        validate_project_context || exit 1
        shift
        docker_exec_notty developer npx "$@"
        ;;
    "node")
        validate_project_context || exit 1
        shift
        docker_exec developer node "$@"
        ;;
    "python"|"python3")
        validate_project_context || exit 1
        shift
        docker_exec developer python3 "$@"
        ;;
    "pip"|"pip3")
        validate_project_context || exit 1
        shift
        if [[ "$1" == "install" ]]; then
            shift
            docker_exec_notty developer pip3 install --break-system-packages "$@"
        else
            docker_exec_notty developer pip3 "$@"
        fi
        ;;
    "shell")
        validate_project_context || exit 1
        # Top-level dispatcher code, not a function: `local` here is an error
        # ("can only be used in a function") and aborted the command.
        _framework=$(detect_project_framework)
        case "$_framework" in
            "laravel")
                docker_exec developer php artisan tinker
                ;;
            "django")
                docker_exec developer python3 manage.py shell
                ;;
            "nestjs")
                if [ -f "src/repl.ts" ]; then
                    docker_exec developer npm run start -- --entryFile repl
                else
                    docker_exec developer node
                fi
                ;;
            "node")
                docker_exec developer node
                ;;
            "python")
                docker_exec developer python3
                ;;
            *)
                echo-yellow "Could not detect framework. Opening bash shell."
                docker_exec developer bash
                ;;
        esac
        ;;
    "django")
        validate_project_context || exit 1
        shift
        case "$1" in
            "manage")
                if [ ! -f "manage.py" ]; then
                    echo-red "No manage.py found. Are you in a Django project directory?"
                    exit 1
                fi
                shift
                docker_exec_notty developer python3 manage.py "$@"
                ;;
            "shell")
                if [ ! -f "manage.py" ]; then
                    echo-red "No manage.py found. Are you in a Django project directory?"
                    exit 1
                fi
                docker_exec developer python3 manage.py shell
                ;;
            "")
                echo-yellow "Usage: zeltro django <subcommand>"
                echo "  zeltro django manage <args>  - Run manage.py with arguments"
                echo "  zeltro django shell          - Open Django interactive shell"
                exit 1
                ;;
            *)
                echo-red "Unknown django subcommand: $1"
                echo "  zeltro django manage <args>  - Run manage.py with arguments"
                echo "  zeltro django shell          - Open Django interactive shell"
                exit 1
                ;;
        esac
        ;;
    "phpcs")
        validate_project_context || exit 1
        shift
        # Auto-attach default ruleset if none provided
        has_standard=false
        for arg in "$@"; do
            case "$arg" in
                --standard=*|--standard)
                    has_standard=true
                    break
                    ;;
            esac
        done
        if [ "$has_standard" = false ]; then
            set -- --standard="/etc/phpcs-ruleset.xml" "$@"
        fi
        docker_exec developer phpcs "$@"
        ;;
    "phpcbf")
        validate_project_context || exit 1
        shift
        # Auto-attach default ruleset if none provided
        has_standard=false
        for arg in "$@"; do
            case "$arg" in
                --standard=*|--standard)
                    has_standard=true
                    break
                    ;;
            esac
        done
        if [ "$has_standard" = false ]; then
            set -- --standard="/etc/phpcs-ruleset.xml" "$@"
        fi
        docker_exec developer phpcbf "$@"
        ;;
    "phpmd")
        validate_project_context || exit 1
        shift
        # Auto-attach default format and ruleset if only a path is provided
        if [ "$#" -eq 1 ]; then
            set -- "$1" text "/etc/phpmd.xml"
        fi
        docker_exec developer phpmd "$@"
        ;;
    
    # Container execution
    "exec")
        validate_project_context || exit 1
        shift
        docker_exec_notty developer "$@"
        ;;
    "exec-root")
        validate_project_context || exit 1
        shift
        docker_exec_notty root "$@"
        ;;
    "exec-tty")
        validate_project_context || exit 1
